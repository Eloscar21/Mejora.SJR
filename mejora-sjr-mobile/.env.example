# Copiar a .env.local. Vacío mantiene la prueba de interfaz (sin autenticar).
# Usar la URL base del BACKEND accesible desde el teléfono, sin /api/auth/login.
# Ejemplo de desarrollo: http://192.168.1.50:5000
# En producción usar HTTPS. No colocar aquí contraseñas, tokens ni JWT_SECRET.
EXPO_PUBLIC_API_URL=
