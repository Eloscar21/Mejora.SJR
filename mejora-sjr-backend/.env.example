# ================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO - MEJORA SJR BACKEND
# ================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env"
# 2. Rellena los valores con las credenciales reales de tu entorno.
# 3. NUNCA subas el archivo .env al repositorio.
# ================================================================

# --- SERVIDOR ---
PORT=5000
NODE_ENV=development

# --- BASE DE DATOS (Azure SQL) ---
DB_SERVER=tu-servidor.database.windows.net
DB_DATABASE=MejoraSJR_DB
DB_USER=tu_usuario_de_bd
DB_PASSWORD=tu_password_super_seguro
DB_PORT=1433

# --- CRIPTOGRAFÍA & SEGURIDAD ---
HASH_COST=10

# --- AUTENTICACIÓN (JWT) ---
JWT_SECRET=ejemplo_de_clave_secreta_jwt_para_desarrollo_local_min_32_caracteres
JWT_EXPIRES_IN=8h

# --- CLOUDINARY (Almacenamiento de Evidencias) ---
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
